{
  "version": 1,
  "repository": "tasks/string-utils",
  "agents": [
    {
      "id": "codex",
      "name": "Codex",
      "command": "codex",
      "args": ["exec", "--json", "--full-auto", "{prompt}"],
      "env": { "OPENAI_API_KEY": "{env:OPENAI_API_KEY}" },
      "inheritEnv": false,
      "tokenParser": "codex-jsonl",
      "timeoutSeconds": 600
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "command": "claude",
      "args": ["-p", "--output-format", "json", "--permission-mode", "acceptEdits", "{prompt}"],
      "env": { "ANTHROPIC_API_KEY": "{env:ANTHROPIC_API_KEY}" },
      "inheritEnv": false,
      "tokenParser": "claude-json",
      "timeoutSeconds": 600
    }
  ],
  "tasks": [
    {
      "id": "unicode-reverse",
      "prompt": "Implement reverseText so it reverses Unicode grapheme clusters, including emoji sequences. Preserve the existing API and add no dependencies.",
      "weight": 1,
      "checks": [
        { "name": "acceptance", "run": "node \"{benchmark}/tasks/string-utils/check.mjs\" \"{workspace}\"", "weight": 1 }
      ]
    }
  ]
}
